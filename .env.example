# ─── Site ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://aviondisplay.com
NEXT_PUBLIC_WA_NUMBER=6281563905555
NEXT_PUBLIC_WA_MESSAGE=Halo,+saya+mau+bertanya+tentang+AVION+Display!

# ─── Contact Form ────────────────────────────────────────
CONTACT_EMAIL=acta.arc@gmail.com

# ─── Telegram Bot ────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Get chat ID from https://api.telegram.org/bot{TOKEN}/getUpdates
TELEGRAM_CHAT_ID=your_chat_id

# ─── GitHub (for posting blog via Telegram) ───────────────
# Create at: github.com/settings/tokens → Fine-grained → Contents: Read & Write
GITHUB_TOKEN=your_github_pat
GITHUB_OWNER=buildwitharyo-ops
GITHUB_REPO=aviondisplay-web2.0

# ─── Supabase Storage (for blog image uploads) ────────────
# Get from: supabase.com → project → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
SUPABASE_BUCKET=blog-images
